# Local overrides for the audit scripts and Playwright. No secrets live here yet.
# Base URL the audits (pnpm audit:*) crawl. Default: http://localhost:3000
AUDIT_BASE_URL=
# Point Playwright at an already running server (skips its own `pnpm start`).
BASE_URL=
# Port `pnpm verify` starts the production server on. Default: 3100
VERIFY_PORT=
