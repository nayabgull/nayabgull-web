# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# `pnpm build` validates these with Zod (lib/env.ts) and fails when one is missing or malformed.

# ── Payload CMS ─────────────────────────────────────────────────────
# Pooled Neon connection string (host contains "-pooler"). Used by the running app.
DATABASE_URI=
# Direct Neon connection string (no "-pooler"). Used only by `pnpm db:migrate`.
DATABASE_URI_DIRECT=
# At least 32 random characters: `openssl rand -hex 32`. Never reuse it between environments.
PAYLOAD_SECRET=

# ── Lead form (optional) ────────────────────────────────────────────
# Cloudflare Turnstile (free). Leave both empty to run the form without the Turnstile check.
# When TURNSTILE_SECRET_KEY is set, every submission needs a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Audits and Playwright ───────────────────────────────────────────

# Base URL the audits (pnpm audit:*) crawl. Default: http://localhost:3000
AUDIT_BASE_URL=
# Point Playwright at an already running server (skips its own `pnpm start`).
BASE_URL=
# Port `pnpm verify` starts the production server on. Default: 3100
VERIFY_PORT=
